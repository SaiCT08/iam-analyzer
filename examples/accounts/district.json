{
  "AccountId": "111122223333",
  "Policies": {
    "TeacherReadGrades": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ListStudentRecordsBucket",
          "Effect": "Allow",
          "Action": "s3:ListBucket",
          "Resource": "arn:aws:s3:::district-student-records"
        },
        {
          "Sid": "ReadStudentRecords",
          "Effect": "Allow",
          "Action": [
            "s3:Get*",
            "s3:List*"
          ],
          "Resource": "arn:aws:s3:::district-student-records/*"
        }
      ]
    },
    "DenyStudentRecordsDelete": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "NoDeleteStudentRecords",
          "Effect": "Deny",
          "Action": [
            "s3:DeleteObject",
            "s3:DeleteObjectVersion",
            "s3:DeleteBucket"
          ],
          "Resource": [
            "arn:aws:s3:::district-student-records",
            "arn:aws:s3:::district-student-records/*"
          ]
        }
      ]
    },
    "SubstituteReadOnlyGuardrail": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "SubstitutesReadOnlyStudentRecords",
          "Effect": "Deny",
          "NotAction": [
            "s3:Get*",
            "s3:List*"
          ],
          "Resource": [
            "arn:aws:s3:::district-student-records",
            "arn:aws:s3:::district-student-records/*"
          ]
        }
      ]
    },
    "ITAdminFullS3": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "FullS3Access",
          "Effect": "Allow",
          "Action": "s3:*",
          "Resource": "*"
        }
      ]
    },
    "StaffReadOnlyEc2AndLogs": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "DescribeEc2",
          "Effect": "Allow",
          "Action": "ec2:Describe*",
          "Resource": "*"
        },
        {
          "Sid": "ReadCampusLogs",
          "Effect": "Allow",
          "Action": [
            "logs:GetLogEvents",
            "logs:FilterLogEvents"
          ],
          "Resource": "arn:aws:logs:us-east-1:111122223333:log-group:/district/campus-??/*"
        }
      ]
    },
    "GradebookVendorBoundary": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "GradebookAppBucketOnly",
          "Effect": "Allow",
          "Action": "s3:*",
          "Resource": [
            "arn:aws:s3:::district-gradebook-app",
            "arn:aws:s3:::district-gradebook-app/*"
          ]
        },
        {
          "Sid": "NoBucketDeletion",
          "Effect": "Deny",
          "Action": "s3:DeleteBucket",
          "Resource": "*"
        }
      ]
    },
    "StudentTeacherBoundary": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "Campus01RecordsOnly",
          "Effect": "Allow",
          "Action": [
            "s3:Get*",
            "s3:List*"
          ],
          "Resource": [
            "arn:aws:s3:::district-student-records",
            "arn:aws:s3:::district-student-records/campus-01/*"
          ]
        }
      ]
    },
    "RegistrarCampusRecords": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ManageOwnCampusRecords",
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:PutObject"
          ],
          "Resource": "arn:aws:s3:::district-student-records/${aws:PrincipalTag/campus}/*"
        },
        {
          "Sid": "RequireMfaForChanges",
          "Effect": "Deny",
          "Action": "s3:PutObject",
          "Resource": "arn:aws:s3:::district-student-records/*",
          "Condition": {
            "BoolIfExists": {
              "aws:MultiFactorAuthPresent": "false"
            }
          }
        }
      ]
    },
    "AssumeITAdminRole": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AssumeITAdmin",
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Resource": "arn:aws:iam::111122223333:role/ITAdmin"
        }
      ]
    },
    "CampusTeacherRecords": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ReadOwnCampusRecords",
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::district-student-records/${aws:PrincipalTag/campus}/*"
        }
      ]
    },
    "SummerSchoolRecords": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ReadCampus01UntilNextYear",
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::district-student-records/campus-01/*",
          "Condition": {
            "DateLessThan": {
              "aws:CurrentTime": "2027"
            }
          }
        }
      ]
    }
  },
  "Groups": {
    "Teachers": {
      "Policies": [
        "TeacherReadGrades",
        "DenyStudentRecordsDelete"
      ]
    },
    "Substitutes": {
      "Policies": [
        "TeacherReadGrades",
        "SubstituteReadOnlyGuardrail"
      ]
    },
    "ITStaff": {
      "Policies": [
        "StaffReadOnlyEc2AndLogs",
        "DenyStudentRecordsDelete",
        "AssumeITAdminRole"
      ]
    },
    "Registrars": {
      "Policies": [
        "RegistrarCampusRecords",
        "DenyStudentRecordsDelete"
      ]
    },
    "SummerSchool": {
      "Policies": [
        "SummerSchoolRecords"
      ]
    }
  },
  "Users": {
    "jsmith": {
      "Groups": [
        "Teachers"
      ]
    },
    "mgarcia": {
      "Groups": [
        "Substitutes"
      ]
    },
    "alee": {
      "Groups": [
        "ITStaff"
      ],
      "Policies": [
        "ITAdminFullS3"
      ]
    },
    "dpatel": {
      "Groups": [
        "Teachers"
      ],
      "PermissionsBoundary": "StudentTeacherBoundary"
    },
    "rnguyen": {
      "Groups": [
        "Registrars"
      ],
      "Tags": [
        {
          "Key": "campus",
          "Value": "campus-02"
        }
      ]
    },
    "kwong": {},
    "tbrooks": {
      "Groups": [
        "SummerSchool"
      ]
    }
  },
  "Roles": {
    "ITAdmin": {
      "Policies": [
        "ITAdminFullS3",
        "DenyStudentRecordsDelete"
      ],
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "AccountWithMfa",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:root"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "Bool": {
                "aws:MultiFactorAuthPresent": "true"
              }
            }
          }
        ]
      }
    },
    "GradebookVendor": {
      "Policies": [
        "ITAdminFullS3"
      ],
      "PermissionsBoundary": "GradebookVendorBoundary",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "VendorAccount",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::444455556666:root"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "StringEquals": {
                "sts:ExternalId": "district-gradebook-7f3a"
              }
            }
          }
        ]
      }
    },
    "TeacherSignIn": {
      "Policies": [
        "CampusTeacherRecords"
      ],
      "Tags": [
        {
          "Key": "campus",
          "Value": "campus-01"
        }
      ],
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "DistrictSignIn",
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::111122223333:saml-provider/DistrictIdP"
            },
            "Action": "sts:AssumeRoleWithSAML",
            "Condition": {
              "StringEquals": {
                "SAML:aud": "https://signin.aws.amazon.com/saml"
              }
            }
          }
        ]
      }
    }
  },
  "Resources": {
    "arn:aws:s3:::district-student-records": {
      "Policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "OnlyITAdminChangesThePolicy",
            "Effect": "Deny",
            "Principal": "*",
            "Action": [
              "s3:PutBucketPolicy",
              "s3:DeleteBucketPolicy"
            ],
            "Resource": "arn:aws:s3:::district-student-records",
            "Condition": {
              "ArnNotEquals": {
                "aws:PrincipalArn": "arn:aws:iam::111122223333:role/ITAdmin"
              }
            }
          },
          {
            "Sid": "CounselorsReadCounselingNotes",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::111122223333:user/kwong"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::district-student-records/counseling/*"
          }
        ]
      }
    },
    "arn:aws:s3:::district-staff-files": {},
    "arn:aws:s3:::district-gradebook-app": {},
    "arn:aws:s3:::district-roster-exports": {
      "Policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "ShareRosterWithVendor",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::district-roster-exports/*"
          }
        ]
      }
    }
  }
}
