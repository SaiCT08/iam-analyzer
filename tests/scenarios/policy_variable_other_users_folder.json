{
  "description": "${aws:username} is the caller's own name, so it doesn't cover another teacher's home folder.",
  "policies": {
    "staff_home_folder.json": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "OwnHomeFolder",
          "Effect": "Allow",
          "Action": ["s3:GetObject", "s3:PutObject"],
          "Resource": "arn:aws:s3:::district-staff-files/home/${aws:username}/*"
        }
      ]
    }
  },
  "context": { "aws:username": "jsmith" },
  "request": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::district-staff-files/home/mgarcia/lesson-plan.docx"
  },
  "expected": "IMPLICIT_DENY"
}
