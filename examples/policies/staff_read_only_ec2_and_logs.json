{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeEc2",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    },
    {
      "Sid": "ReadCampusLogs",
      "Effect": "Allow",
      "Action": ["logs:GetLogEvents", "logs:FilterLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:111122223333:log-group:/district/campus-??/*"
    }
  ]
}
