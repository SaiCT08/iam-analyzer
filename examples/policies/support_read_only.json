{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SupportIsReadOnly",
      "Effect": "Deny",
      "NotAction": [
        "s3:Get*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::anycompany-prod-*",
        "arn:aws:s3:::anycompany-prod-*/*"
      ]
    }
  ]
}
