{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSupportBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::anycompany-prod-*",
        "arn:aws:s3:::anycompany-prod-*/*"
      ]
    }
  ]
}
